[Unit]
Description=Sur (ytmusicapi + yt-dlp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sur
Environment=PORT=5000
ExecStart=/opt/sur/venv/bin/python app.py
Restart=always
RestartSec=5
# Stream-URL cache lives in RAM; restart clears it (re-resolves on demand).

[Install]
WantedBy=multi-user.target
